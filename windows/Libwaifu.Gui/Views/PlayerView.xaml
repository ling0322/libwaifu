<!-- Play, pause, where it has got to, and how long it runs. It never starts on its own. -->
<UserControl x:Class="Libwaifu.Gui.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <TextBlock Text="cannot play this" Style="{StaticResource CaptionText}"
               Visibility="{Binding HasTrouble, Converter={StaticResource BoolToVisible}}" />

    <DockPanel Visibility="{Binding HasTrouble, Converter={StaticResource BoolToCollapsed}}">
      <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="24" Height="22"
              Command="{Binding Toggle}">
        <Grid>
          <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="12" Height="12"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Visibility="{Binding Playing, Converter={StaticResource BoolToCollapsed}}" />
          <Path Data="{StaticResource IconPause}" Stretch="Uniform" Width="12" Height="12"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Visibility="{Binding Playing, Converter={StaticResource BoolToVisible}}" />
        </Grid>
      </Button>

      <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                 Style="{StaticResource CaptionText}" FontFamily="{StaticResource MonoFont}">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} / {1}">
            <Binding Path="PositionText" />
            <Binding Path="LengthText" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>

      <Slider x:Name="Along" Style="{StaticResource MacSlider}" Margin="8,0,0,0" Minimum="0"
              Maximum="{Binding Length}" Value="{Binding Position}"
              GotMouseCapture="OnHeld" LostMouseCapture="OnLetGo" />
    </DockPanel>
  </Grid>
</UserControl>
