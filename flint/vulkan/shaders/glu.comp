#extension GL_GOOGLE_include_directive : require
// The gated linear units: a contiguous A (..., 2D) into C (..., D), C = A[..., D:] * act(A[..., :D])
// -- the first half is the gate. GEGLU when op is 1, SwiGLU when it is 0. In float.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint numel;  // of C
  uint halfWidth;  // D
  uint op;
} pc;

void main() {
  uint i = globalIndex();
  if (i >= pc.numel) return;

  uint row = i / pc.halfWidth;
  uint column = i - row * pc.halfWidth;
  uint base = row * 2 * pc.halfWidth;

  float gate = LOAD_A(pc.a, base + column);
  float value = LOAD_A(pc.a, base + pc.halfWidth + column);
  float activated = pc.op == 1 ? gelu(gate) : silu(gate);
  STORE_C(pc.c, i, value * activated);
}
