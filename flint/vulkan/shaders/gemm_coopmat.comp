#extension GL_GOOGLE_include_directive : require
// gemm.comp on cooperative matrices, for half precision operands that can be read eight
// elements at a time: A laid out along K, and B along K or along N, with every row and every
// batch starting on sixteen bytes. The batch is gl_WorkGroupID.z, b0 * batch1 + b1, and C is
// contiguous. Strides and offsets are in elements.
#include "common.glsl"
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint64_t b;
  uint M;
  uint N;
  uint K;
  uint strideAm;
  uint strideB;  // between rows of B: along n when B is laid out along K, along k otherwise
  uint alongN;
  uint batch1;
  uint strideA0;
  uint strideA1;
  uint strideB0;
  uint strideB1;
} pc;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer Vec8Buffer {
  uvec4 v[];
};

uint offsetA;
uint offsetB;
uint offsetC;

uvec4 loadA8(uint m, uint k) {
  if (m >= pc.M || k >= pc.K) return uvec4(0);
  return Vec8Buffer(pc.a).v[(offsetA + m * pc.strideAm + k) / 8];
}

uvec4 loadB8K(uint n, uint k) {
  if (n >= pc.N || k >= pc.K) return uvec4(0);
  return Vec8Buffer(pc.b).v[(offsetB + n * pc.strideB + k) / 8];
}

uvec4 loadB8N(uint k, uint n) {
  if (k >= pc.K || n >= pc.N) return uvec4(0);
  return Vec8Buffer(pc.b).v[(offsetB + k * pc.strideB + n) / 8];
}

bool bAlongN() {
  return pc.alongN != 0;
}

float biasOf(uint n) {
  return 0.0;
}

#define Tile coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void storeTile(Tile tile, uint m, uint n) {
  coopMatStore(tile, BufferC(pc.c).v, offsetC + m * pc.N + n, pc.N,
               gl_CooperativeMatrixLayoutRowMajor);
}

void storeC(uint m, uint n, float value) {
  STORE_C(pc.c, offsetC + m * pc.N + n, value);
}

#include "gemm_coopmat_core.glsl"

void main() {
  uint batch = gl_WorkGroupID.z;
  uint b0 = batch / pc.batch1;
  uint b1 = batch - b0 * pc.batch1;
  offsetA = b0 * pc.strideA0 + b1 * pc.strideA1;
  offsetB = b0 * pc.strideB0 + b1 * pc.strideB1;
  offsetC = batch * pc.M * pc.N;

  gemm(pc.M, pc.N, pc.K);
}
