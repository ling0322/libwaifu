#extension GL_GOOGLE_include_directive : require
// x + sin(alpha * x)^2 / (beta + eps) per channel of a contiguous A (N, C, L), into C. alpha and
// beta are (C), of A's type; a beta of zero is alpha, the plain snake.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint64_t alpha;
  uint64_t beta;
  uint numel;
  uint width;  // L; `length` is a method in GLSL
  uint channels;
  float eps;
} pc;

void main() {
  uint i = globalIndex();
  if (i >= pc.numel) return;

  uint channel = (i / pc.width) % pc.channels;
  float x = LOAD_A(pc.a, i);

  // GLSL bounds sin's error only inside [-pi, pi], and alpha * x is routinely outside it, so the
  // argument is brought into that range first rather than trusting each driver beyond it.
  const float kTwoPi = 6.28318530717958647692;
  float angle = LOAD_A(pc.alpha, channel) * x;
  float s = sin(angle - kTwoPi * round(angle / kTwoPi));
  float divisor = LOAD_A(pc.beta != 0 ? pc.beta : pc.alpha, channel) + pc.eps;
  STORE_C(pc.c, i, x + s * s / divisor);
}
