#extension GL_GOOGLE_include_directive : require
// Softmax over the last dimension of a contiguous A, into C. A workgroup per row, in float.
#include "common.glsl"
#include "rows.glsl"

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint numRows;
  uint rowLength;
} pc;

void main() {
  uint row = rowIndex();
  if (row >= pc.numRows) return;

  uint tid = gl_LocalInvocationID.x;
  uint base = row * pc.rowLength;

  float m = -1.0 / 0.0;
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) m = max(m, LOAD_A(pc.a, base + i));
  m = reduceRow(m, REDUCE_MAX);

  float s = 0.0;
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) s += exp(LOAD_A(pc.a, base + i) - m);
  s = reduceRow(s, REDUCE_SUM);

  float scale = 1.0 / s;
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) {
    STORE_C(pc.c, base + i, exp(LOAD_A(pc.a, base + i) - m) * scale);
  }
}
