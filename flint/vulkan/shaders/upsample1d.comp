#extension GL_GOOGLE_include_directive : require
// Resizing the last dimension of a contiguous A (rows, width) to C (rows, size), each output
// element copying input min(floor(j * scale), width - 1) with scale = float(width) / size --
// torch's `F.interpolate(size=size, mode="nearest")`. `precise` keeps the product one rounded
// float32 multiply, so the index is torch's even where it lands a hair under a whole number.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint numel;  // of C
  uint width;  // of A's rows; `length` is a method in GLSL
  uint size;
  float scale;
} pc;

void main() {
  uint i = globalIndex();
  if (i >= pc.numel) return;

  uint j = i % pc.size;
  uint row = i / pc.size;

  precise float position = float(j) * pc.scale;
  uint source = min(uint(floor(position)), pc.width - 1u);
  STORE_C_RAW(pc.c, i, LOAD_A_RAW(pc.a, row * pc.width + source));
}
