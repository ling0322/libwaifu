#extension GL_GOOGLE_include_directive : require
// col2im, the second half of a transposed 1-D convolution: one thread per element of C (N, K,
// Lout), gathering from the contiguous columns A (N * L, K * R) the taps that land on it and
// adding the bias, of A's type, unless its address is zero. Input position `l` lands tap `r` on
// `l * stride + r - padding`, so the taps reaching `o` are those congruent to `o + padding`
// modulo the stride. C's last dimension is contiguous; its batch and channel strides are given,
// since a group writes its own channels of the result.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint64_t bias;
  uint numel;  // of C
  uint inWidth;  // L
  uint stride;
  uint padding;
  uint kernel;
  uint channels;
  uint outWidth;
  uint batchStride;
  uint channelStride;
} pc;

void main() {
  uint i = globalIndex();
  if (i >= pc.numel) return;

  uint o = i % pc.outWidth;
  uint plane = i / pc.outWidth;
  uint k = plane % pc.channels;
  uint n = plane / pc.channels;

  uint row = pc.channels * pc.kernel;
  uint base = n * pc.inWidth * row + k * pc.kernel;
  int at = int(o + pc.padding);
  int stride = int(pc.stride);

  float sum = pc.bias != 0 ? LOAD_A(pc.bias, k) : 0.0;
  for (int r = at % stride; r < int(pc.kernel); r += stride) {
    int l = (at - r) / stride;
    if (l < 0) break;
    if (l < int(pc.inWidth)) sum += LOAD_A(pc.a, base + uint(l) * row + uint(r));
  }
  STORE_C(pc.c, n * pc.batchStride + k * pc.channelStride + o, sum);
}
