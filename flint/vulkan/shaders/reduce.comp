#extension GL_GOOGLE_include_directive : require
// Sum, maximum or minimum of each row of a contiguous A, into C[row]. A workgroup per row,
// accumulated in float. For bool, the sum is an `all`: whether every element is true.
#include "common.glsl"
#include "rows.glsl"

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint numRows;
  uint rowLength;
  uint op;
} pc;

void main() {
  uint row = rowIndex();
  if (row >= pc.numRows) return;

  uint tid = gl_LocalInvocationID.x;
  uint base = row * pc.rowLength;

#if defined(A_BOOL)
  float x = 1.0;
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) x = min(x, LOAD_A(pc.a, base + i));
  x = reduceRow(x, REDUCE_MIN);
#else
  float x = pc.op == REDUCE_SUM ? 0.0 : (pc.op == REDUCE_MAX ? -1.0 / 0.0 : 1.0 / 0.0);
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) {
    x = combine(x, LOAD_A(pc.a, base + i), pc.op);
  }
  x = reduceRow(x, pc.op);
#endif

  if (tid == 0) STORE_C(pc.c, row, x);
}
