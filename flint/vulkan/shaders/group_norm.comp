#extension GL_GOOGLE_include_directive : require
// Group norm of a contiguous A (N, C, H, W) into C. A workgroup per (n, group), whose elements
// are one contiguous run; then scaled and shifted per channel by the optional weight and bias,
// which are A's type. Statistics in float, the same way layer_norm.comp takes them.
#include "common.glsl"
#include "rows.glsl"

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint64_t weight;
  uint64_t bias;
  uint numGroups;       // N * groups
  uint groupLength;     // (C / groups) * H * W
  uint spatial;         // H * W
  uint channelsPerGroup;
  uint groups;
  float eps;
} pc;

void main() {
  uint group = rowIndex();
  if (group >= pc.numGroups) return;

  uint tid = gl_LocalInvocationID.x;
  uint base = group * pc.groupLength;

  vec2 sums = vec2(0.0);
  for (uint i = tid; i < pc.groupLength; i += ROW_THREADS) {
    float x = LOAD_A(pc.a, base + i);
    sums += vec2(x, x * x);
  }
  sums = sumRow2(sums) / float(pc.groupLength);

  float mean = sums.x;
  float variance = sums.y - mean * mean;
  float invStd = inversesqrt(variance > 0.0 ? variance + pc.eps : pc.eps);

  uint firstChannel = (group % pc.groups) * pc.channelsPerGroup;
  for (uint i = tid; i < pc.groupLength; i += ROW_THREADS) {
    float y = (LOAD_A(pc.a, base + i) - mean) * invStd;
    uint channel = firstChannel + i / pc.spatial;
    if (pc.weight != 0) y *= LOAD_A(pc.weight, channel);
    if (pc.bias != 0) y += LOAD_A(pc.bias, channel);
    STORE_C(pc.c, base + i, y);
  }
}
