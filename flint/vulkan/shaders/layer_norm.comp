#extension GL_GOOGLE_include_directive : require
// Layer norm over the last dimension of a contiguous A, into C. A workgroup per row, in float.
// The weight and bias are A's type and each is left out when its address is zero. RMS_NORM
// builds the variant without a mean, where the weight is not optional.
//
// The variance is E[x^2] - E[x]^2, and eps goes inside the square root, as on the other devices.
#include "common.glsl"
#include "rows.glsl"

layout(push_constant) uniform Push {
  uint64_t c;
  uint64_t a;
  uint64_t weight;
  uint64_t bias;
  uint numRows;
  uint rowLength;
  float eps;
} pc;

void main() {
  uint row = rowIndex();
  if (row >= pc.numRows) return;

  uint tid = gl_LocalInvocationID.x;
  uint base = row * pc.rowLength;

  vec2 sums = vec2(0.0);
  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) {
    float x = LOAD_A(pc.a, base + i);
    sums += vec2(x, x * x);
  }
  sums = sumRow2(sums) / float(pc.rowLength);

#if defined(RMS_NORM)
  float mean = 0.0;
#else
  float mean = sums.x;
#endif
  float variance = sums.y - mean * mean;
  float invStd = inversesqrt(variance > 0.0 ? variance + pc.eps : pc.eps);

  for (uint i = tid; i < pc.rowLength; i += ROW_THREADS) {
    float y = (LOAD_A(pc.a, base + i) - mean) * invStd;
    if (pc.weight != 0) y *= LOAD_A(pc.weight, i);
    if (pc.bias != 0) y += LOAD_A(pc.bias, i);
    STORE_C(pc.c, base + i, y);
  }
}
