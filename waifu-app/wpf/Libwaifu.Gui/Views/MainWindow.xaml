<!--
  The window: a toolbar across the top, and under it the sidebar, the task, and the settings.

  The three columns are a Grid rather than nested panes because the two dividers are draggable and
  the middle takes whatever is left; the settings column can also be put away, which is the one
  thing the toolbar's right-hand button does.
-->
<Window x:Class="Libwaifu.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Libwaifu.Gui.Controls"
        xmlns:vm="clr-namespace:Libwaifu.Gui.ViewModels"
        Title="libwaifu"
        Width="1280" Height="860" MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="{StaticResource BodySize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- A row of the Model popup. Two of its rows are not models and cannot be picked. -->
    <Style x:Key="ModelItem" TargetType="ComboBoxItem" BasedOn="{StaticResource PopupItem}">
      <Setter Property="IsEnabled" Value="{Binding Pickable}" />
    </Style>

    <DataTemplate x:Key="ModelChoiceTemplate">
      <Grid>
        <TextBlock x:Name="Words" Text="{Binding Display}" />
        <Rectangle x:Name="Rule" Height="1" Margin="0,4" VerticalAlignment="Center"
                   Fill="{StaticResource SeparatorBrush}" Visibility="Collapsed" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHeading}" Value="True">
          <Setter TargetName="Words" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
          <Setter TargetName="Words" Property="FontSize" Value="{StaticResource CaptionSize}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRule}" Value="True">
          <Setter TargetName="Words" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Rule" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A task in the sidebar: the coloured square, then its name. -->
    <DataTemplate x:Key="SidebarTaskTemplate">
      <StackPanel Orientation="Horizontal">
        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding IconBrush}">
          <Path Data="{Binding Icon}" Stroke="White" StrokeThickness="1.6" Stretch="Uniform"
                Width="12" Height="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" />
        </Border>
        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="200" MaxWidth="420" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" MinWidth="460" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="300" MaxWidth="420" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- — the toolbar =================================================================== -->

    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource IconButton}" Width="28" Height="24"
            Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
            Command="{Binding ToggleSidebar}" ToolTip="Show or hide the sidebar">
      <Path Data="{StaticResource IconSidebarLeft}" Stretch="Uniform" Width="17" Height="17"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.3" />
    </Button>

    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
      <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"
                 Visibility="{Binding Subtitle, Converter={StaticResource EmptyToCollapsed}}" />
    </StackPanel>

    <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource IconButton}" Width="28" Height="24"
            Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
            Command="{Binding ToggleInspector}" ToolTip="Show or hide the settings"
            Visibility="{Binding InspectorButtonVisible, Converter={StaticResource BoolToVisible}}">
      <Path Data="{StaticResource IconSidebarRight}" Stretch="Uniform" Width="17" Height="17"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.3" />
    </Button>

    <!-- — the sidebar =================================================================== -->

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel LastChildFill="True">

        <!-- What this machine is, read again every two seconds. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12">
          <TextBlock Text="This PC" Style="{StaticResource HeadlineText}" Margin="0,0,0,8" />

          <TextBlock Text="CPU" Style="{StaticResource Caption2Text}" />
          <TextBlock Text="{Binding Machine.CpuName}" ToolTip="{Binding Machine.CpuName}" />
          <TextBlock Text="{Binding Machine.Threads}" Style="{StaticResource CaptionText}"
                     Margin="0,0,0,10" />

          <TextBlock Text="MEMORY" Style="{StaticResource Caption2Text}" />
          <TextBlock Text="{Binding Machine.Memory}" />
          <ProgressBar Value="{Binding Machine.MemoryFraction, Mode=OneWay}" Margin="0,4,0,10"
                       Style="{StaticResource MiniProgress}">
            <ProgressBar.Resources>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource MiniProgress}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Machine.MemoryTight}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Resources>
          </ProgressBar>

          <TextBlock Text="GPU" Style="{StaticResource Caption2Text}" />
          <TextBlock Text="{Binding Machine.GpuName}" ToolTip="{Binding Machine.GpuName}" />
          <TextBlock Text="{Binding Machine.Vram}" Style="{StaticResource CaptionText}" />
          <ProgressBar Value="{Binding Machine.VramFraction, Mode=OneWay}" Margin="0,4,0,0"
                       Style="{StaticResource MiniProgress}"
                       Visibility="{Binding Machine.VramMeasured, Converter={StaticResource BoolToVisible}}">
            <ProgressBar.Resources>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource MiniProgress}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Machine.VramTight}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Resources>
          </ProgressBar>
          <Border Height="10" />

          <TextBlock Text="ACCELERATORS" Style="{StaticResource Caption2Text}" />
          <TextBlock Text="{Binding Machine.Accelerators}" Style="{StaticResource CaptionText}" />
        </StackPanel>

        <StackPanel Margin="8,8,8,0">
          <TextBlock Text="Tasks" Style="{StaticResource CaptionText}" Margin="8,2,0,4" />
          <ListBox Style="{StaticResource SidebarList}"
                   ItemsSource="{Binding Tasks}"
                   SelectedItem="{Binding SelectedTask}"
                   ItemTemplate="{StaticResource SidebarTaskTemplate}" />

          <TextBlock Text="Models" Style="{StaticResource CaptionText}" Margin="8,14,0,4" />
          <ListBox Style="{StaticResource SidebarList}"
                   ItemsSource="{Binding ModelPages}"
                   SelectedItem="{Binding SelectedModels}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Width="20" Height="20" CornerRadius="5"
                          Background="{StaticResource TaskModelsBrush}">
                    <Path Data="{StaticResource IconBox}" Stroke="White" StrokeThickness="1.6"
                          Stretch="Uniform" Width="12" Height="12" StrokeLineJoin="Round" />
                  </Border>
                  <TextBlock Text="Model Manager" Margin="8,0,0,0" VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- — the two dividers, each a hairline with a wider grip over it ==================== -->

    <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource PaneSplitBrush}" />
    <GridSplitter x:Name="SidebarSplitter" Grid.Row="1" Grid.Column="1" Width="7"
                  HorizontalAlignment="Center" Background="Transparent"
                  ResizeBehavior="PreviousAndNext" />

    <!-- — the task ====================================================================== -->

    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Page}" />

    <Rectangle x:Name="InspectorLine" Grid.Row="1" Grid.Column="3"
               Fill="{StaticResource PaneSplitBrush}" />
    <GridSplitter x:Name="InspectorSplitter" Grid.Row="1" Grid.Column="3" Width="7"
                  HorizontalAlignment="Center" Background="Transparent"
                  ResizeBehavior="PreviousAndNext" />

    <!-- — the settings ================================================================== -->

    <Border x:Name="Inspector" Grid.Row="1" Grid.Column="4" Background="{StaticResource SidebarBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                    DataContext="{Binding CurrentTask}">
        <StackPanel>

          <!-- The Model card, which is the same on every task page. -->
          <Grid Margin="2,0,0,6">
            <TextBlock Text="Model" Style="{StaticResource HeadlineText}" />
            <Button Style="{StaticResource IconButton}" Width="22" Height="18"
                    HorizontalAlignment="Right" ToolTip="What the library has written"
                    Command="{Binding DataContext.ShowLog, RelativeSource={RelativeSource AncestorType=Window}}">
              <Path Data="{StaticResource IconLines}" Stretch="Uniform" Width="13" Height="13"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" />
            </Button>
          </Grid>

          <c:FormGroup RowPadding="{StaticResource InspectorRowPadding}"
                       Footnote="{Binding ModelFootnote}"
                       FootnoteIsError="{Binding ModelFootnoteIsError}">
            <c:SettingRow Label="Model">
              <ComboBox Style="{StaticResource PopupButton}"
                        ItemsSource="{Binding ModelChoices}"
                        SelectedItem="{Binding SelectedChoice}"
                        ItemTemplate="{StaticResource ModelChoiceTemplate}"
                        ItemContainerStyle="{StaticResource ModelItem}"
                        IsEnabled="{Binding SettingsEnabled}"
                        ToolTip="{Binding SelectedChoice.Display}" />
            </c:SettingRow>
            <c:SettingRow Label="Device">
              <ComboBox Style="{StaticResource PopupButton}"
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding Device}"
                        IsEnabled="{Binding SettingsEnabled}" />
            </c:SettingRow>
          </c:FormGroup>

          <!--
            And under it, whatever this task is asked with. Until a model is chosen there is
            nothing to ask: the settings are the model's own, so the column is the card alone.
          -->
          <ContentControl Margin="0,12,0,0" Content="{Binding}"
                          ContentTemplateSelector="{StaticResource InspectorSelector}"
                          Visibility="{Binding ChosenModel, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
