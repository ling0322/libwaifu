<!--
  The middle of the window on a picture page: what to draw and the button above, what came out
  below.
-->
<UserControl x:Class="Libwaifu.Gui.Views.ImageTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Libwaifu.Gui.Controls">
  <Grid>

    <!-- Nothing can be asked for without a model, so until one is chosen this is the whole page. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding ChosenModel, Converter={StaticResource EmptyToVisible}}">
      <Path Data="{StaticResource IconBox}" Stretch="Uniform" Width="40" Height="40"
            Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.1"
            StrokeLineJoin="Round" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Name, StringFormat='No model for {0}'}" Margin="0,14,0,0"
                 FontSize="{StaticResource Title3Size}" HorizontalAlignment="Center" />
      <Button Style="{StaticResource LinkButton}" Margin="0,8,0,0" HorizontalAlignment="Center"
              Content="Choose one in the Model card on the right"
              Command="{Binding DataContext.ToggleInspector, RelativeSource={RelativeSource AncestorType=Window}}" />
    </StackPanel>

    <Grid Visibility="{Binding ChosenModel, Converter={StaticResource EmptyToCollapsed}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- — what to draw ============================================================== -->

      <StackPanel Grid.Row="0" Margin="16">
        <!--
          Two boxes side by side, or one across the whole width: a uniform grid of one row counts
          only the children that are showing, so hiding the second widens the first.
        -->
        <UniformGrid Rows="1">
          <c:FormGroup Title="Prompt" RowPadding="{StaticResource CenterRowPadding}">
            <TextBox Style="{StaticResource PromptBox}"
                     Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                     Tag="What to draw: a list of tags, the most important first" />
          </c:FormGroup>

          <!-- A model distilled for no guidance has nothing to be steered away from. -->
          <c:FormGroup Title="Away from" Margin="12,0,0,0"
                       RowPadding="{StaticResource CenterRowPadding}"
                       Visibility="{Binding TakesGuidance, Converter={StaticResource BoolToVisible}}">
            <TextBox Style="{StaticResource PromptBox}"
                     Text="{Binding Avoid, UpdateSourceTrigger=PropertyChanged}"
                     Tag="What to keep out: worst quality, bad hands" />
          </c:FormGroup>
        </UniformGrid>

        <Button Style="{StaticResource GoButton}" Margin="0,10,0,0"
                Content="{Binding ActionWord}" Command="{Binding Go}"
                IsEnabled="{Binding GoEnabled}" />
      </StackPanel>

      <Rectangle Grid.Row="1" Fill="{StaticResource PaneSplitBrush}" />

      <!-- — what came out ============================================================= -->

      <Grid Grid.Row="2" Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisible}}">
          <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100"
                       Value="{Binding ProgressValue, Mode=OneWay}"
                       IsIndeterminate="{Binding Indeterminate}" />
          <TextBlock Text="{Binding ProgressLine}" Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" />
        </StackPanel>

        <!-- The reason a run failed can be a paragraph, so it wraps rather than being cut. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10"
                   Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisible}}">
          <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Stretch="Uniform"
                Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,6,0"
                Fill="{StaticResource DangerBrush}"
                Visibility="{Binding NoticeIsError, Converter={StaticResource BoolToVisible}}" />
          <Path DockPanel.Dock="Left" Data="{StaticResource IconInfo}" Stretch="Uniform"
                Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" StrokeThickness="1.4"
                Stroke="{StaticResource TextSecondaryBrush}"
                Visibility="{Binding NoticeIsError, Converter={StaticResource BoolToCollapsed}}" />
          <TextBox Text="{Binding Notice, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                   Padding="0" Background="Transparent" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
        </DockPanel>

        <!-- The picture itself, which keeps its shape and is as big as the room allows. -->
        <Grid Grid.Row="2">
          <TextBlock Text="{Binding NothingYet}" Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding HasResult, Converter={StaticResource BoolToCollapsed}}" />
          <Image Source="{Binding Selected.Picture}" Stretch="Uniform"
                 ToolTip="{Binding Selected.Parameters}">
            <Image.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy"
                          Command="{Binding PlacementTarget.DataContext.CopyPicture,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Copy parameters"
                          Command="{Binding PlacementTarget.DataContext.CopyParameters,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </Image.ContextMenu>
          </Image>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0"
              Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SmallButton}" Content="Save..." Command="{Binding Save}" />
            <Button Style="{StaticResource SmallButton}" Content="Reuse these settings"
                    Margin="8,0,0,0" Command="{Binding Reuse}" />
          </StackPanel>
          <Button Style="{StaticResource SmallButtonDanger}" Content="Delete"
                  HorizontalAlignment="Right" Command="{Binding Delete}" />
        </Grid>

        <!-- Everything ever drawn, newest first. -->
        <ListBox Grid.Row="4" Style="{StaticResource Strip}" Height="62" Margin="0,10,0,0"
                 ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}"
                 Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Rectangle Width="56" Height="56" RadiusX="5" RadiusY="5" ToolTip="{Binding Hover}">
                <Rectangle.Fill>
                  <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                </Rectangle.Fill>
              </Rectangle>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
