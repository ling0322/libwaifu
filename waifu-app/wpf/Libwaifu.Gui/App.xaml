<Application x:Class="Libwaifu.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Libwaifu.Gui.ViewModels"
             xmlns:views="clr-namespace:Libwaifu.Gui.Views"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.xaml" />
        <ResourceDictionary Source="Theme/Icons.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Which view goes with which page. The middle of the window and the settings column are two
        different views of the same page, so each task has two templates and the column picks its
        one by key.
      -->
      <DataTemplate DataType="{x:Type vm:ImageTaskViewModel}">
        <views:ImageTaskView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:SpeechTaskViewModel}">
        <views:SpeechTaskView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:ConversionTaskViewModel}">
        <views:ConversionTaskView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
        <views:ModelManagerView />
      </DataTemplate>

      <DataTemplate x:Key="Inspector.Image">
        <views:ImageInspector />
      </DataTemplate>

      <DataTemplate x:Key="Inspector.Speech">
        <views:SpeechInspector />
      </DataTemplate>

      <DataTemplate x:Key="Inspector.Conversion">
        <views:ConversionInspector />
      </DataTemplate>

      <views:InspectorSelector x:Key="InspectorSelector" />

      <!--
        The one button worth pressing. It is the accent colour while there is something to start
        and red while there is something to stop, which along with the word on it is most of what
        says a run is happening.
      -->
      <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Working}" Value="True">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The die inside the left end of the seed box. -->
      <Style x:Key="DieButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="ToolTip" Value="A seed between one and 65535" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
