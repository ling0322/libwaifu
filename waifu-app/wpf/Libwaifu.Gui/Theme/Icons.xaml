  <Geometry x:Key="IconPlay">F1 M7.5,4.5 L19,12 L7.5,19.5 Z</Geometry>
  <Geometry x:Key="IconPause">F1 M7,4.5 H10.5 V19.5 H7 Z M13.5,4.5 H17 V19.5 H13.5 Z</Geometry>
  <Geometry x:Key="IconChevronUpDown">F1 M12,3.4 L16.2,8.2 H7.8 Z M12,20.6 L7.8,15.8 H16.2 Z</Geometry>

