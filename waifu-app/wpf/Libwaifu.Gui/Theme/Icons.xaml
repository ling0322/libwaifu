<!--
  The drawings on the screen, as paths rather than as a font.

  Each one is the same subject as the symbol the mac asks SF Symbols for =  text.below.photo over
  txt2img, photo.on.rectangle over img2img, waveform over text2speech, person.wave.2 over
  speech2speech, shippingbox for the models =  drawn here rather than taken from there, because
  SF Symbols is Apple's and is not on this machine. All of them are drawn in a 24x24 box and
  scaled by whoever uses them; the outlined ones are meant to be stroked, the ones marked filled
  to be filled.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Outlined. -->

  <!-- text.below.photo: a picture with the words that made it underneath. -->
  <Geometry x:Key="IconPicture">M3,5 A2,2 0 0 1 5,3 H19 A2,2 0 0 1 21,5 V13 A2,2 0 0 1 19,15 H5 A2,2 0 0 1 3,13 Z M3.5,12.5 L7.5,8.5 L10.5,11.5 M9.5,11 L12.5,7.5 L20.5,14 M3,18.5 H21 M3,21.5 H14</Geometry>

  <!-- photo.on.rectangle: one picture over another. -->
  <Geometry x:Key="IconPictureStack">M7.5,3.5 H19.5 A1.5,1.5 0 0 1 21,5 V13.5 M4.5,7.5 H16 A1.5,1.5 0 0 1 17.5,9 V18.5 A1.5,1.5 0 0 1 16,20 H4.5 A1.5,1.5 0 0 1 3,18.5 V9 A1.5,1.5 0 0 1 4.5,7.5 Z M3.5,17.5 L7.5,13.5 L10,16 M9.5,15.5 L12.5,12.5 L17.5,17</Geometry>

  <!-- waveform: what a voice looks like. -->
  <Geometry x:Key="IconWaveform">M3.5,11 V13 M7,7.5 V16.5 M10.5,4.5 V19.5 M14,8.5 V15.5 M17.5,6 V18 M21,10.5 V13.5</Geometry>

  <!-- person.wave.2: somebody, and their voice going out. -->
  <Geometry x:Key="IconConversion">M11.5,7 A3,3 0 1 1 5.5,7 A3,3 0 1 1 11.5,7 Z M2.5,19.5 A6,6 0 0 1 14.5,19.5 M16.5,8 A5,5 0 0 1 16.5,15.5 M19.5,5.5 A8.5,8.5 0 0 1 19.5,18</Geometry>

  <!-- shippingbox: a model, as a thing that arrives. -->
  <Geometry x:Key="IconBox">M3.5,7.5 L12,3.5 L20.5,7.5 V16.5 L12,20.5 L3.5,16.5 Z M3.5,7.5 L12,11.5 L20.5,7.5 M12,11.5 V20.5</Geometry>

  <Geometry x:Key="IconTrash">M5,7 H19 M10,7 V5.2 A1.2,1.2 0 0 1 11.2,4 H12.8 A1.2,1.2 0 0 1 14,5.2 V7 M6.8,7 L7.7,19.4 A1.6,1.6 0 0 0 9.3,21 H14.7 A1.6,1.6 0 0 0 16.3,19.4 L17.2,7</Geometry>

  <!-- text.alignleft: the log. -->
  <Geometry x:Key="IconLines">M4,6 H20 M4,10.5 H14.5 M4,15 H20 M4,19.5 H14.5</Geometry>

  <Geometry x:Key="IconSidebarLeft">M3,6 A2,2 0 0 1 5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z M9.5,4 V20</Geometry>
  <Geometry x:Key="IconSidebarRight">M3,6 A2,2 0 0 1 5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z M14.5,4 V20</Geometry>

  <!-- info.circle: something worth saying that is not a failure. -->
  <Geometry x:Key="IconInfo">M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 Z M12,10.8 V17 M12,7.1 V7.9</Geometry>

  <!-- xmark.circle: take the recording away again. -->
  <Geometry x:Key="IconClose">M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 Z M8.8,8.8 L15.2,15.2 M15.2,8.8 L8.8,15.2</Geometry>

  <!-- photo.badge.plus and waveform.badge.plus: the two boxes something is dropped on. -->
  <Geometry x:Key="IconPicturePlus">M3,7 A2,2 0 0 1 5,5 H12.5 M3,7 V17 A2,2 0 0 1 5,19 H17 A2,2 0 0 1 19,17 V11.5 M3.5,16.5 L7.5,12.5 L10,15 M9.5,14.5 L12.5,11.5 L18,17 M17.5,3 V9 M14.5,6 H20.5</Geometry>
