+// An embedded metallib wins over every on-disk lookup: a binary that carries
+// its own kernels should never silently pick up a stray copy from the disk.
+MTL::Library* load_embedded_library(MTL::Device* device) {
+  auto [data, size] = get_metallib_data();
+  if (data == nullptr) {
+    return nullptr;
+  }
+
+  // A non-null destructor is what makes this a borrow rather than a copy: the
+  // default one tells libdispatch to duplicate the whole buffer, and an
+  // embedded metallib is far too big to want a second copy of. The buffer
+  // outlives the process, so the destructor has nothing to do.
+  auto owned = dispatch_data_create(data, size, nullptr, ^{
+                                    });
+  NS::Error* error;
+  auto lib = device->newLibrary(owned, &error);
+  dispatch_release(owned);
+
+  if (!lib) {
+    throw std::runtime_error(
+        fmt::format(
+            "Can not load the embedded metallib: {}.",
+            error->localizedDescription()->utf8String()));
+  }
+  return lib;
+}
